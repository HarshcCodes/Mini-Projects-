            )

    def get_all_students(self) -> List[Student]:
        return list(self.students.values())

    def get_student(self, student_id: int) -> Optional[Student]:
        return self.students.get(student_id)

    def get_dashboard_metrics(self) -> Dict[str, object]:
        students = self.get_all_students()
        total = len(students)
        overall_pct = sum(s.attendance for s in students) / total if total > 0 else 0.0

        return {
            "total_students": total,
            "overall_attendance_pct": round(overall_pct, 1),
            "safe_count": sum(1 for s in students if s.risk == RiskLevel.SAFE),
            "watch_count": sum(1 for s in students if s.risk == RiskLevel.WATCH),
            "at_risk_count": sum(1 for s in students if s.risk == RiskLevel.AT_RISK)
        }

    def generate_recovery_plan(self, student_id: int, target_pct: float = 75.0) -> Dict[str, object]:
        student = self.get_student(student_id)
        if not student:
            raise ValueError(f"Student ID {student_id} not found.")

        needed = calculate_recovery_classes(student.attended_classes, student.total_classes, target_pct)
        return {
            "name": student.name,
            "current_attendance": student.attendance,
            "target_attendance": target_pct,
            "consecutive_classes_needed": needed
        }

    def export_csv(self) -> str:
        output = io.StringIO()
        writer = csv.writer(output)
        writer.writerow(["ID", "Name", "Roll No", "Class", "Attendance %", "Streak", "Risk"])
        for s in self.get_all_students():
            writer.writerow([s.id, s.name, s.roll_no, s.class_name, f"{s.attendance:.1f}", s.streak, s.risk.value])
        return output.getvalue()
