from __future__ import annotations
import math
import csv
import io
from dataclasses import dataclass, asdict
from enum import Enum
from typing import List, Dict, Optional


class AttendanceStatus(str, Enum):
    PRESENT = "Present"
    ABSENT = "Absent"
    LATE = "Late"


class RiskLevel(str, Enum):
    SAFE = "Safe"
    WATCH = "Watch"
    AT_RISK = "At Risk"


@dataclass
class Settings:
    school_name: str = "Global International School"
    academic_year: str = "2025-2026"
    warning_threshold: float = 85.0    # >= 85%: Safe, 75-84%: Watch
    critical_threshold: float = 75.0   # < 75%: At Risk


@dataclass
class Student:
    id: int
    name: str
    roll_no: str
    class_name: str
    attendance: float
    total_classes: int
    attended_classes: int
    streak: int = 0
    risk: RiskLevel = RiskLevel.SAFE

    def to_dict(self) -> dict:
        data = asdict(self)
        data["risk"] = self.risk.value
        return data


# ==============================================================================
# 1. CORE ALGORITHMS & MATHEMATICAL FORMULAS
# ==============================================================================

def calculate_risk(
    attendance_pct: float,
    warning_threshold: float = 85.0,
    critical_threshold: float = 75.0
) -> RiskLevel:
    """
    Rule-based attendance classification:
    - >= 85% : Safe
    - 75% - 84%: Watch
    - < 75%  : At Risk
    """
    if attendance_pct >= warning_threshold:
        return RiskLevel.SAFE
    elif attendance_pct >= critical_threshold:
        return RiskLevel.WATCH
    else:
        return RiskLevel.AT_RISK


def calculate_recovery_classes(
    attended: int,
    total: int,
    target_pct: float
) -> int:
    """
    Calculates consecutive classes 'x' needed to reach target_pct:
    Formula:
        (attended + x) / (total + x) >= target_pct / 100
        x = ceil((target_pct * total - 100 * attended) / (100 - target_pct))
    """
    if total <= 0:
        return 0

    current_pct = (attended / total) * 100.0
    if current_pct >= target_pct:
        return 0

    if target_pct >= 100.0:
        return -1 if attended < total else 0

    numerator = (target_pct * total) - (100.0 * attended)
    denominator = 100.0 - target_pct

    needed = math.ceil(numerator / denominator)
    return max(0, needed)


def calculate_what_if(
    attended: int,
    total: int,
    upcoming_classes: int,
    missed_in_upcoming: int = 0
) -> Dict[str, float]:
    """
    Simulates projected attendance across upcoming classes.
    """
    current_pct = (attended / total * 100.0) if total > 0 else 0.0
    projected_total = total + upcoming_classes
    attended_in_upcoming = max(0, upcoming_classes - missed_in_upcoming)
    projected_attended = attended + attended_in_upcoming

    projected_pct = (
        (projected_attended / projected_total * 100.0)
        if projected_total > 0 else 0.0
    )

    return {
        "current_pct": round(current_pct, 2),
        "projected_pct": round(projected_pct, 2),
        "net_diff_pct": round(projected_pct - current_pct, 2),
        "attended_total": projected_attended,
        "classes_total": projected_total
    }


def record_student_attendance(
    student: Student,
    status: AttendanceStatus,
    settings: Settings = Settings()
) -> Student:
    """
    Updates attendance counts and streak:
    - PRESENT: attended + 1, total + 1, streak + 1
    - LATE:    attended + 1, total + 1, streak resets to 0
    - ABSENT:  attended + 0, total + 1, streak resets to 0
    """
    new_attended = student.attended_classes
    new_total = student.total_classes + 1
    new_streak = student.streak

    if status == AttendanceStatus.PRESENT:
        new_attended += 1
        new_streak += 1
    elif status == AttendanceStatus.LATE:
        new_attended += 1
        new_streak = 0
    elif status == AttendanceStatus.ABSENT:
        new_streak = 0

    new_pct = round((new_attended / new_total) * 100.0, 1) if new_total > 0 else 0.0
    new_risk = calculate_risk(
        new_pct,
        warning_threshold=settings.warning_threshold,
        critical_threshold=settings.critical_threshold
    )

    student.attended_classes = new_attended
    student.total_classes = new_total
    student.attendance = new_pct
    student.streak = new_streak
    student.risk = new_risk

    return student


