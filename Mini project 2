    print("-" * 82)

    for number, student in enumerate(
        students,
        start=1
    ):
        if student["cgpa"] is None:
            cgpa_display = "N/A"
        else:
            cgpa_display = f"{student['cgpa']:.2f}"

        print(
            f"{number:<5}"
            f"{student['name'][:19]:<20}"
            f"{student['average']:<10.1f}"
            f"{cgpa_display:<14}"
            f"{student['grade']:<8}"
            f"{student['result']:<9}"
        )

    print_separator()


# ================================================================
# 12. SEARCH
# ================================================================

def search_students(students):
    """Search student records by name."""
    if not students:
        print("No student records available.")
        return

    search = input(
        "Enter student name to search: "
    ).strip().lower()

    if not search:
        print("ERROR: Search term cannot be empty.")
        return

    results = [
        student
        for student in students
        if search in student["name"].lower()
    ]

    print()
    print_separator()
    print("SEARCH RESULTS")
    print_separator()

    if not results:
        print("No students found.")

    else:
        for student in results:
            if student["cgpa"] is None:
                cgpa_text = "N/A"
            else:
                cgpa_text = f"{student['cgpa']:.2f}"

            print(
                f"{student['name']} | "
                f"Average: {student['average']:.1f}% | "
                f"CGPA: {cgpa_text} | "
                f"Grade: {student['grade']} | "
                f"Result: {student['result']} | "
                f"Trend: "
                f"{analyze_trend(student['semester_marks'])}"
            )

    print_separator()


# ================================================================
# 13. FILTER
# ================================================================

def filter_students(students):
    """Filter students by result or risk status."""
    if not students:
        print("No student records available.")
        return

    print()
    print("1. All Students")
    print("2. Passed Students")
    print("3. Failed Students")
    print("4. At-Risk Students")

    choice = input(
        "Choose filter: "
    ).strip()

    if choice == "1":
        filtered = students

    elif choice == "2":
        filtered = [
            student
            for student in students
            if student["result"] == "PASS"
        ]

    elif choice == "3":
        filtered = [
            student
            for student in students
            if student["result"] == "FAIL"
        ]

    elif choice == "4":
        filtered = [
            student
            for student in students
            if student["at_risk"]
        ]

    else:
        print("ERROR: Invalid filter.")
        return

    display_all_students(filtered)


