def class_analytics(students):
    """Display class-level performance analytics."""
    print()
    print_separator()
    print("                         CLASS ANALYTICS")
    print_separator()

    if not students:
        print("No student records available.")
        print("Evaluate at least one student first.")
        print_separator()
        return

    averages = [
        student["average"]
        for student in students
    ]

    # Only students who pass all subjects have a CGPA.
    valid_cgpas = [
        student["cgpa"]
        for student in students
        if student["cgpa"] is not None
    ]

    total = len(students)
    class_average = sum(averages) / total

    if valid_cgpas:
        average_cgpa = sum(valid_cgpas) / len(valid_cgpas)
    else:
        average_cgpa = None

    passed = sum(
        student["result"] == "PASS"
        for student in students
    )

    failed = total - passed

    at_risk = sum(
        student["at_risk"]
        for student in students
    )

    highest = max(
        students,
        key=lambda student: student["average"]
    )

    lowest = min(
        students,
        key=lambda student: student["average"]
    )

    print(f"Total Students    : {total}")
    print(f"Class Average     : {class_average:.2f}%")

    if average_cgpa is None:
        print("Average CGPA      : N/A (No student has a valid CGPA)")
    else:
        print(
            f"Average CGPA      : {average_cgpa:.2f} "
            f"(passing students only)"
        )

    print(
        f"Pass Rate         : "
        f"{(passed / total) * 100:.2f}%"
    )

    print(f"Passed            : {passed}")
    print(f"Failed            : {failed}")
    print(f"At-Risk Students  : {at_risk}")

    print(
        f"Highest Average   : "
        f"{highest['average']:.2f}% "
        f"({highest['name']})"
    )

    print(
        f"Lowest Average    : "
        f"{lowest['average']:.2f}% "
        f"({lowest['name']})"
    )

    # ------------------------------------------------------------
    # Grade distribution
    # ------------------------------------------------------------

    grade_counts = {
        "A+": 0,
        "A": 0,
        "B": 0,
        "C": 0,
        "D": 0,
        "F": 0
    }

    for student in students:
        grade_counts[student["grade"]] += 1

    print_separator("-")
    print("OVERALL GRADE DISTRIBUTION")

    for grade, count in grade_counts.items():
        print(
            f"{grade:<3}: "
            f"{'█' * count} "
            f"({count})"
        )

    # ------------------------------------------------------------
    # Trend distribution
    # ------------------------------------------------------------

    trend_counts = {
        "Improving": 0,
        "Declining": 0,
        "Stable": 0,
        "Insufficient Data": 0
    }

    for student in students:
        trend = analyze_trend(
            student["semester_marks"]
        )

        trend_counts[trend] += 1

    print_separator("-")
    print("TREND DISTRIBUTION")

    for trend, count in trend_counts.items():
        print(
            f"{trend:<18}: {count}"
        )

    # ------------------------------------------------------------
    # Subject-wise class averages
    # ------------------------------------------------------------

    print_separator("-")
    print("SUBJECT-WISE CLASS AVERAGES")

    totals = {}
    counts = {}

    for student in students:
        for data in student["subject_data"]:
            subject = data["subject"]

            totals[subject] = (
                totals.get(subject, 0)
                + data["marks"]
            )

            counts[subject] = (
                counts.get(subject, 0)
                + 1
            )

    for subject in totals:
        subject_average = (
            totals[subject] / counts[subject]
        )

        print(
            f"{subject:<25}: "
            f"{subject_average:.2f}%"
        )

    # ------------------------------------------------------------
    # Failed subject frequency
    # ------------------------------------------------------------

    print_separator("-")
    print("MOST COMMON FAILED SUBJECTS")

    failed_subject_counts = {}

    for student in students:
        failed_subjects = get_failed_subjects(
            student["subjects"],
            student["subject_marks"]
        )

        for subject in failed_subjects:
            failed_subject_counts[subject] = (
                failed_subject_counts.get(subject, 0) + 1
            )

    if failed_subject_counts:
        sorted_subjects = sorted(
            failed_subject_counts.items(),
            key=lambda item: item[1],
            reverse=True
        )

        for subject, count in sorted_subjects:
            print(
                f"{subject:<25}: "
                f"{count} student(s)"
            )
    else:
        print("No failed subjects recorded.")

    print_separator()


