"""
====================================================================
SMARTGRADE
5-Subject Student Performance, CGPA & Progress Tracking System
====================================================================

MINI PROJECT - PYTHON MODULE 02

MAIN RULE:
- Each student has exactly 5 subjects/courses.
- Marks are validated between 0 and 100.
- Any subject with marks from 0 to 49 = FAIL.
- If even ONE subject is failed:
      Overall Result = FAIL
      Overall Grade  = F
      CGPA            = NOT APPLICABLE
- CGPA is calculated ONLY when the student passes all 5 subjects.

CGPA SCALE:
A+ = 10
A  = 9
B  = 8
C  = 7
D  = 6
F  = 0

OTHER FEATURES:
- Personalized overall insights
- Subject-wise improvement insights
- At-risk alert for marks below 40%
- Next-grade target
- Previous semester comparison
- Improving / Declining / Stable trend
- Performance growth
- Highest and lowest semester
- Multiple student records
- Search
- Filtering
- Class analytics
- Subject-wise class averages
- Demo data
- Error handling and validation
- Structured student reports
====================================================================
"""


SUBJECT_COUNT = 5


# ================================================================
# 1. GRADE AND RESULT FUNCTIONS
# ================================================================

def calculate_grade(marks):
    """Assign a grade based on the predefined marking criteria."""
    if marks >= 90:
        return "A+"
    elif marks >= 80:
        return "A"
    elif marks >= 70:
        return "B"
    elif marks >= 60:
        return "C"
    elif marks >= 50:
        return "D"
    else:
        return "F"


def grade_to_points(grade):
    """Convert grade to a 10-point grade value."""
    points = {
        "A+": 10,
        "A": 9,
        "B": 8,
        "C": 7,
        "D": 6,
        "F": 0
    }

    return points[grade]


def evaluate_result(marks):
    """A subject is passed only if marks are 50 or above."""
    if marks >= 50:
        return "PASS"

    return "FAIL"


def get_academic_status(marks):
    """Return a descriptive performance status."""
    if marks >= 90:
        return "Outstanding"
    elif marks >= 80:
        return "Excellent"
    elif marks >= 70:
        return "Very Good"
    elif marks >= 60:
        return "Good"
    elif marks >= 50:
        return "Satisfactory"
    elif marks >= 40:
        return "Needs Attention"
    else:
        return "Critical / At Risk"


def get_remark(grade):
    """Return an overall performance remark."""
    remarks = {
        "A+": "Outstanding Performance",
        "A": "Excellent Performance",
        "B": "Very Good Performance",
        "C": "Good Performance",
        "D": "Satisfactory Performance",
        "F": "Needs Improvement"
    }

    return remarks[grade]


# ================================================================
# 2. ACADEMIC CALCULATION FUNCTIONS
# ================================================================

def calculate_average(subject_marks):
    """Calculate average percentage across the 5 subjects."""
    return sum(subject_marks) / len(subject_marks)


def has_failed_subject(subject_marks):
    """Return True if any subject has marks below 50."""
    return any(mark < 50 for mark in subject_marks)


def calculate_overall_result(subject_marks):
    """
    Overall PASS requires passing every subject.

    Any score from 0-49 means the student fails.
    """
    if has_failed_subject(subject_marks):
        return "FAIL"

    return "PASS"


def calculate_cgpa(subject_marks):
    """
    Calculate CGPA ONLY if all 5 subjects are passed.

    If any subject is below 50, return None because
    CGPA is not awarded to a failed student.
    """
    if has_failed_subject(subject_marks):
        return None

    total_points = 0

    for marks in subject_marks:
        grade = calculate_grade(marks)
        total_points += grade_to_points(grade)

    return total_points / len(subject_marks)


def calculate_overall_grade(subject_marks):
    """
    Failed students receive F and no CGPA.

    Passing students receive an overall grade based on CGPA.
    """
    if has_failed_subject(subject_marks):
        return "F"

    cgpa = calculate_cgpa(subject_marks)

    if cgpa >= 9:
        return "A+"
    elif cgpa >= 8:
        return "A"
    elif cgpa >= 7:
        return "B"
    elif cgpa >= 6:
        return "C"
    elif cgpa >= 5:
        return "D"
    else:
        return "F"


# ================================================================
# 3. PERSONALIZED INSIGHT FUNCTIONS
# ================================================================

def get_improvement_insight(marks, subject_marks):
    """
    Generate an overall personalized insight.

    Failed students receive a more urgent recommendation.
    """
    if has_failed_subject(subject_marks):
        return (
            "Your current result is FAIL because one or more subjects "
            "are below 50%. CGPA is not applicable until all subjects "
            "meet the passing requirement. Prioritize your failed "
            "subjects, strengthen fundamentals, and practice regularly."
        )

    if marks >= 90:
        return (
            "Outstanding work! Your performance is excellent. "
            "Maintain consistency and challenge yourself with advanced "
            "concepts and application-based problems."
        )
    elif marks >= 80:
        return (
            "Excellent performance. Focus on accuracy and consistency "
            "to move closer to the A+ range."
        )
    elif marks >= 70:
        return (
            "You have a strong foundation. Strengthen concept clarity "
            "and practice application-based questions to improve further."
        )
    elif marks >= 60:
        return (
            "You are doing well. Focus on regular revision, concept "
            "clarity, and solving more practice questions."
        )
    else:
        return (
            "You have passed, but your performance can improve. "
            "Increase regular practice and revise fundamental concepts."
        )


def get_subject_insight(subject, marks):
    """Generate a personalized insight for each subject."""
    if marks >= 90:
        return (
            f"{subject}: Excellent performance. Maintain consistency "
            "and aim for mastery."
        )

    elif marks >= 80:
        return (
            f"{subject}: Strong performance. Improve accuracy "
            "to target A+."
        )

    elif marks >= 70:
        return (
            f"{subject}: Good foundation. Practice more "
            "application-based questions."
        )

    elif marks >= 60:
        return (
            f"{subject}: Good progress. Focus on revision "
            "and concept clarity."
        )

    elif marks >= 50:
        return (
            f"{subject}: Passed, but additional practice "
            "can improve your grade."
        )

    elif marks >= 40:
        return (
            f"{subject}: Needs attention. Revise fundamentals "
            "and practice regularly."
        )

    else:
        return (
            f"{subject}: AT RISK. This subject is below 40%. "
            "Prioritize fundamentals, practice regularly, "
            "and seek academic support."
        )


def get_at_risk_subjects(subjects, marks):
    """Return subjects where marks are below the 40% early-warning threshold."""
    at_risk = []

    for index in range(len(subjects)):
        if marks[index] < 40:
            at_risk.append(subjects[index])

    return at_risk


def get_failed_subjects(subjects, marks):
    """Return subjects where marks are below the passing threshold."""
    failed = []

    for index in range(len(subjects)):
        if marks[index] < 50:
            failed.append(subjects[index])

    return failed


# ================================================================
# 4. NEXT-GRADE TARGET FUNCTIONS
# ================================================================

def marks_to_next_grade(marks):
    """Calculate marks required to reach the next percentage grade."""
    targets = [
        (90, "A+"),
        (80, "A"),
        (70, "B"),
        (60, "C"),
        (50, "D")
    ]

    for target, grade in targets:
        if marks < target:
            return (
                f"{target - marks:.1f} mark(s) needed "
                f"to reach Grade {grade}."
            )

    return "Maximum percentage grade achieved: A+."


def cgpa_to_next_grade(cgpa):
    """
    Calculate the CGPA required to reach the next grade.

    This is only used for students who have passed all subjects.
    """
    if cgpa is None:
        return "CGPA target unavailable because the student has failed."

    targets = [
        (9, "A+"),
        (8, "A"),
        (7, "B"),
        (6, "C"),
        (5, "D")
    ]

    for target, grade in targets:
        if cgpa < target:
            return (
                f"{target - cgpa:.2f} CGPA point(s) needed "
                f"to reach {grade}."
            )

    return "Maximum CGPA grade achieved: A+."


# ================================================================
# 5. SEMESTER COMPARISON FUNCTIONS
# ================================================================

def analyze_trend(semester_marks):
    """Determine whether semester performance is improving or declining."""
    if len(semester_marks) < 2:
        return "Insufficient Data"

    differences = []

    for index in range(1, len(semester_marks)):
        difference = semester_marks[index] - semester_marks[index - 1]
        differences.append(difference)

    positive = sum(1 for value in differences if value > 1)
    negative = sum(1 for value in differences if value < -1)

    if positive > negative:
        return "Improving"
    elif negative > positive:
        return "Declining"
    else:
        return "Stable"


def calculate_growth(semester_marks):
    """Calculate percentage change from first to current semester."""
    if len(semester_marks) < 2:
        return 0

    if semester_marks[0] == 0:
        return 0

    first = semester_marks[0]
    current = semester_marks[-1]

    return ((current - first) / first) * 100


def get_highest_semester(semester_marks):
    """Return the highest semester number and score."""
    if not semester_marks:
        return None

    highest = max(semester_marks)
    semester_number = semester_marks.index(highest) + 1

    return semester_number, highest


def get_lowest_semester(semester_marks):
    """Return the lowest semester number and score."""
    if not semester_marks:
        return None

    lowest = min(semester_marks)
    semester_number = semester_marks.index(lowest) + 1

    return semester_number, lowest


def get_trend_insight(semester_marks):
    """Generate an insight based on previous semester performance."""
    trend = analyze_trend(semester_marks)

    if trend == "Improving":
        return (
            "Your performance is improving across semesters. "
            "Continue your current study habits and maintain "
            "this positive momentum."
        )

    elif trend == "Declining":
        return (
            "Your performance is declining. Review changes in your "
            "study routine and focus on subjects where marks dropped."
        )

    elif trend == "Stable":
        return (
            "Your performance is relatively stable. Identify one "
            "or two weak areas and target them for improvement."
        )

    else:
        return (
            "Add previous semester data to unlock detailed "
            "trend analysis."
        )


# ================================================================
# 6. INPUT VALIDATION AND ERROR HANDLING
# ================================================================

def get_student_name():
    """Safely accept a non-empty student name."""
    while True:
        name = input("Enter student name: ").strip()

        if not name:
            print("ERROR: Student name cannot be empty.")

        elif len(name) < 2:
            print("ERROR: Please enter a valid name.")

        else:
            return name


def get_subject_name(number):
    """Safely accept a subject/course name."""
    while True:
        subject = input(
            f"Enter Subject/Course {number} name: "
        ).strip()

        if not subject:
            print("ERROR: Subject name cannot be empty.")

        else:
            return subject


def get_valid_marks(prompt):
    """
    Safely accept marks between 0 and 100.

    Handles:
    - Non-numeric input
    - Negative values
    - Values above 100
    """
    while True:
        try:
            marks = float(input(prompt).strip())

            if marks < 0 or marks > 100:
                print(
                    "ERROR: Marks must be between 0 and 100."
                )
            else:
                return marks

        except ValueError:
            print(
                "ERROR: Please enter a valid numeric value."
            )


def get_yes_no(prompt):
    """Safely accept a Yes/No response."""
    while True:
        answer = input(prompt).strip().lower()

        if answer in ("y", "yes"):
            return True

        elif answer in ("n", "no"):
            return False

        else:
            print("ERROR: Please enter Y or N.")


# ================================================================
# 7. STUDENT RECORD CREATION
# ================================================================

def create_student_record(
    name,
    subjects,
    marks,
    semester_marks
):
    """Create a structured student record."""
    if len(subjects) != SUBJECT_COUNT:
        raise ValueError("Exactly 5 subjects are required.")

    if len(marks) != SUBJECT_COUNT:
        raise ValueError("Exactly 5 subject marks are required.")

    average = calculate_average(marks)
    result = calculate_overall_result(marks)
    cgpa = calculate_cgpa(marks)
    overall_grade = calculate_overall_grade(marks)

    subject_data = []

    for subject, mark in zip(subjects, marks):
        grade = calculate_grade(mark)

        subject_data.append({
            "subject": subject,
            "marks": mark,
            "grade": grade,
            "grade_points": grade_to_points(grade),
            "result": evaluate_result(mark),
            "status": get_academic_status(mark)
        })

    return {
        "name": name,
        "subjects": subjects,
        "subject_marks": marks,
        "subject_data": subject_data,
        "average": average,
        "cgpa": cgpa,
        "grade": overall_grade,
        "result": result,
        "status": get_academic_status(average),
        "remark": get_remark(overall_grade),
        "insight": get_improvement_insight(
            average,
            marks
        ),
        "at_risk": any(mark < 40 for mark in marks),
        "semester_marks": semester_marks
    }


