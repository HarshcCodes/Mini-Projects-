def evaluate_new_student():
    """Collect details for a new student."""
    print()
    print_separator()
    print("                   EVALUATE NEW STUDENT")
    print_separator()

    name = get_student_name()

    subjects = []
    marks = []

    print()
    print("Enter exactly 5 subjects/courses.")
    print("Marks must be between 0 and 100.")
    print()
    print(
        "PASSING RULE: Every subject must have at least 50 marks."
    )
    print(
        "If any subject is below 50, the student FAILS "
        "and CGPA is NOT APPLICABLE."
    )

    print()

    for number in range(1, SUBJECT_COUNT + 1):
        subject = get_subject_name(number)

        mark = get_valid_marks(
            f"Enter marks for {subject}: "
        )

        subjects.append(subject)
        marks.append(mark)

    average = calculate_average(marks)
    result = calculate_overall_result(marks)
    cgpa = calculate_cgpa(marks)
    grade = calculate_overall_grade(marks)

    print()
    print_separator("-")
    print("CURRENT SEMESTER SUMMARY")
    print_separator("-")

    print(f"Average Percentage : {average:.2f}%")
    print(f"Overall Grade      : {grade}")
    print(f"Overall Result     : {result}")

    if cgpa is None:
        print("CGPA               : NOT APPLICABLE (FAILED)")
    else:
        print(f"CGPA               : {cgpa:.2f} / 10.00")

    print_separator("-")

    # ------------------------------------------------------------
    # PREVIOUS SEMESTER INPUT
    # ------------------------------------------------------------

    previous_semesters = []

    print()
    print("PREVIOUS SEMESTER DATA")
    print(
        "Enter previous semester average percentages "
        "for comparison."
    )
    print(
        "Enter N when there are no more previous semesters."
    )

    while True:
        answer = input(
            "Add a previous semester? (Y/N): "
        ).strip().lower()

        if answer in ("n", "no"):
            break

        elif answer in ("y", "yes"):
            previous_mark = get_valid_marks(
                f"Enter Semester "
                f"{len(previous_semesters) + 1} average: "
            )

            previous_semesters.append(previous_mark)

        else:
            print("ERROR: Please enter Y or N.")

    # Current semester is automatically included.
    semester_marks = previous_semesters + [average]

    return create_student_record(
        name,
        subjects,
        marks,
        semester_marks
    )


