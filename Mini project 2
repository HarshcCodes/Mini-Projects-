def main():
    """Run the SmartGrade application."""
    students = []

    while True:
        show_menu()

        choice = input(
            "Enter your choice (1-9): "
        ).strip()

        # --------------------------------------------------------
        # OPTION 1 - NEW STUDENT
        # --------------------------------------------------------

        if choice == "1":
            try:
                student = evaluate_new_student()

                students.append(student)

                print()
                print("Student evaluated successfully!")

                display_student_report(student)

            except ValueError as error:
                print(f"ERROR: {error}")

        # --------------------------------------------------------
        # OPTION 2 - ALL STUDENTS
        # --------------------------------------------------------

        elif choice == "2":
            display_all_students(students)

        # --------------------------------------------------------
        # OPTION 3 - STUDENT REPORT
        # --------------------------------------------------------

        elif choice == "3":
            student = choose_student(students)

            if student:
                display_student_report(student)

        # --------------------------------------------------------
        # OPTION 4 - SEARCH
        # --------------------------------------------------------

        elif choice == "4":
            search_students(students)

        # --------------------------------------------------------
        # OPTION 5 - FILTER
        # --------------------------------------------------------

        elif choice == "5":
            filter_students(students)

        # --------------------------------------------------------
        # OPTION 6 - CLASS ANALYTICS
        # --------------------------------------------------------

        elif choice == "6":
            class_analytics(students)

        # --------------------------------------------------------
        # OPTION 7 - DEMO DATA
        # --------------------------------------------------------

        elif choice == "7":
            demo_students = load_demo_data()

            students.extend(demo_students)

            print(
                f"{len(demo_students)} demo student "
                "records loaded successfully."
            )

        # --------------------------------------------------------
        # OPTION 8 - CLEAR RECORDS
        # --------------------------------------------------------

        elif choice == "8":
            if not students:
                print("There are no records to clear.")

            elif get_yes_no(
                "Are you sure you want to clear "
                "all records? (Y/N): "
            ):
                students.clear()
                print(
                    "All student records have been cleared."
                )

            else:
                print("Clear operation cancelled.")

        # --------------------------------------------------------
        # OPTION 9 - EXIT
        # --------------------------------------------------------

        elif choice == "9":
            print()
            print("Thank you for using SmartGrade!")
            print(
                "Turn marks into meaningful academic insights."
            )
            break

        # --------------------------------------------------------
        # INVALID MENU OPTION
        # --------------------------------------------------------

        else:
            print(
                "ERROR: Please choose a number from 1 to 9."
            )


