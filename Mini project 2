def print_separator(char="=", length=82):
    print(char * length)


def display_student_report(student):
    """Display a complete structured student report."""
    print()
    print_separator()
    print("                    SMARTGRADE STUDENT REPORT")
    print_separator()

    print(f"Student Name       : {student['name']}")
    print(f"Average Percentage : {student['average']:.2f}%")

    # IMPORTANT:
    # Failed students do NOT receive a CGPA.
    if student["cgpa"] is None:
        print("CGPA               : NOT APPLICABLE (FAILED)")
    else:
        print(
            f"CGPA               : "
            f"{student['cgpa']:.2f} / 10.00"
        )

    print(f"Overall Grade      : {student['grade']}")
    print(f"Overall Result     : {student['result']}")
    print(f"Academic Status    : {student['status']}")
    print(f"Performance Remark : {student['remark']}")

    print_separator("-")
    print("SUBJECT-WISE PERFORMANCE")
    print_separator("-")

    print(
        f"{'Subject':<25}"
        f"{'Marks':<10}"
        f"{'Grade':<8}"
        f"{'Points':<9}"
        f"{'Result':<10}"
    )

    print("-" * 82)

    for data in student["subject_data"]:
        print(
            f"{data['subject'][:24]:<25}"
            f"{data['marks']:<10.1f}"
            f"{data['grade']:<8}"
            f"{data['grade_points']:<9}"
            f"{data['result']:<10}"
        )

    print_separator("-")
    print("PERSONALIZED OVERALL INSIGHT")
    print(student["insight"])

    print_separator("-")
    print("SUBJECT IMPROVEMENT INSIGHTS")

    for data in student["subject_data"]:
        insight = get_subject_insight(
            data["subject"],
            data["marks"]
        )

        print("• " + insight)

    print_separator("-")
    print("NEXT GRADE TARGET")

    print(marks_to_next_grade(student["average"]))

    if student["cgpa"] is not None:
        print(cgpa_to_next_grade(student["cgpa"]))
    else:
        print(
            "CGPA target unavailable because "
            "the student has failed."
        )

    failed_subjects = get_failed_subjects(
        student["subjects"],
        student["subject_marks"]
    )

    if failed_subjects:
        print_separator("-")
        print("FAILED SUBJECTS")
        print("• " + "\n• ".join(failed_subjects))

        print()
        print(
            "IMPORTANT: Because at least one subject is below 50%, "
            "the student has FAILED and CGPA is NOT APPLICABLE."
        )

    at_risk_subjects = get_at_risk_subjects(
        student["subjects"],
        student["subject_marks"]
    )

    if at_risk_subjects:
        print_separator("-")
        print("ACADEMIC SUPPORT ALERT")
        print(
            "Subjects below 40% (early-warning threshold):"
        )

        for subject in at_risk_subjects:
            print(f"• {subject}")

        print()
        print(
            "Recommendation: Focus on fundamentals, regular practice, "
            "revision, and academic support."
        )

    # ------------------------------------------------------------
    # SEMESTER COMPARISON
    # ------------------------------------------------------------

    semesters = student["semester_marks"]

    if len(semesters) >= 2:
        print_separator("-")
        print("PREVIOUS SEMESTER COMPARISON")

        for number, mark in enumerate(semesters, start=1):
            print(
                f"Semester {number:<3}: "
                f"{mark:.1f}% | "
                f"Grade {calculate_grade(mark)}"
            )

        trend = analyze_trend(semesters)
        growth = calculate_growth(semesters)

        print_separator("-")
        print(f"Performance Trend  : {trend}")

        if growth > 0:
            print(
                f"Performance Change : +{growth:.2f}%"
            )
        else:
            print(
                f"Performance Change : {growth:.2f}%"
            )

        highest = get_highest_semester(semesters)
        lowest = get_lowest_semester(semesters)

        print(
            f"Highest Semester   : "
            f"Semester {highest[0]} ({highest[1]:.1f}%)"
        )

        print(
            f"Lowest Semester    : "
            f"Semester {lowest[0]} ({lowest[1]:.1f}%)"
        )

        print()
        print("TREND INSIGHT")
        print(get_trend_insight(semesters))

    print_separator()
    print("End of Student Report")
    print_separator()


