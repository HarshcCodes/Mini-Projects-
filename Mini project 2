def choose_student(students):
    """Allow the user to choose a student by record number."""
    if not students:
        print("No student records available.")
        return None

    display_all_students(students)

    try:
        choice = int(
            input("Enter student number: ")
        )

        if 1 <= choice <= len(students):
            return students[choice - 1]

        print("ERROR: Invalid student number.")

    except ValueError:
        print(
            "ERROR: Please enter a valid whole number."
        )

    return None


