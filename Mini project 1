# 2. INDIAN NUMBER-TO-WORDS CONVERTER (Lakhs & Crores)
# =============================================================================
ONES = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
        "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen",
        "Seventeen", "Eighteen", "Nineteen"]
TENS = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"]


def _two_digits_to_words(n: int) -> str:
    if n == 0:
        return ""
    if n < 20:
        return ONES[n]
    tens_digit = n // 10
    ones_digit = n % 10
    return TENS[tens_digit] + (" " + ONES[ones_digit] if ones_digit > 0 else "")


def _three_digits_to_words(n: int) -> str:
    hundreds = n // 100
    remainder = n % 100
    res = []
    if hundreds > 0:
        res.append(ONES[hundreds] + " Hundred")
    if remainder > 0:
        res.append(_two_digits_to_words(remainder))
    return " ".join(res)


def amount_to_indian_words(amount: float) -> str:
    """
    Converts currency amounts into Indian numbering words (Lakhs & Crores).
    Example: 145230.50 -> 'Rupees One Lakh Forty Five Thousand Two Hundred Thirty and Fifty Paise Only'
    """
    amount = round(amount, 2)
    if amount <= 0:
        return "Rupees Zero Only"

    rupees = int(amount)
    paise = int(round((amount - rupees) * 100))

    parts = []
    if rupees > 0:
        crores = rupees // 10000000
        rupees %= 10000000

        lakhs = rupees // 100000
        rupees %= 100000

        thousands = rupees // 1000
        rupees %= 1000

        hundreds_and_below = rupees

        if crores > 0:
            parts.append(_three_digits_to_words(crores) + " Crore")
        if lakhs > 0:
            parts.append(_two_digits_to_words(lakhs) + " Lakh")
        if thousands > 0:
            parts.append(_two_digits_to_words(thousands) + " Thousand")
        if hundreds_and_below > 0:
            parts.append(_three_digits_to_words(hundreds_and_below))

        rupee_str = "Rupees " + " ".join(parts).strip()
    else:
        rupee_str = ""

    paise_str = ""
    if paise > 0:
        paise_str = _two_digits_to_words(paise) + " Paise"

    if rupee_str and paise_str:
        return f"{rupee_str} and {paise_str} Only"
    elif rupee_str:
        return f"{rupee_str} Only"
    else:
        return f"{paise_str} Only"


# =============================================================================
# 3. AI SMART QUICK-BILLER (NATURAL LANGUAGE PARSER)
# =============================================================================
def parse_natural_language_items(text: str) -> List[Item]:
    """
    Standout Feature: Automatically extracts product name, quantity, price,
    and GST rate from unstructured text or speech transcription.
    
    Examples handled:
      - '2x Wireless Mouse at 499 18% gst'
      - '5kg Basmati Rice @ 95 5% gst'
      - 'Coffee Mug 199 12% gst'
    """
    lines = [line.strip() for line in re.split(r"[\n;,]+", text) if line.strip()]
    parsed_items = []

    for line in lines:
        working_line = line
        qty = 1.0
        price = 0.0
        gst_rate = 18.0

        # 1. Detect explicit GST rate (e.g. '18% gst', '5%')
        gst_match = re.search(r'(\d+(?:\.\d+)?)\s*%\s*(?:gst)?', working_line, re.IGNORECASE)
        if gst_match:
            try:
                rate_val = float(gst_match.group(1))
                if rate_val in [0, 5, 12, 18, 28]:
                    gst_rate = rate_val
                working_line = working_line[:gst_match.start()] + " " + working_line[gst_match.end():]
            except ValueError:
                pass

        # 2. Detect Price with indicator keywords (@, at, rs, inr, price)
        price_patterns = [
            r'(?:@|at|price|rate|cost|rs\.?|inr)\s*[:=]?\s*(\d+(?:\.\d+)?)',
            r'(\d+(?:\.\d+)?)\s*(?:each|per\s+piece|rs|inr|\/-)'
        ]
        price_found = False
        for p in price_patterns:
            m = re.search(p, working_line, re.IGNORECASE)
            if m:
                try:
                    price = float(m.group(1))
                    price_found = True
                    working_line = working_line[:m.start()] + " " + working_line[m.end():]
                    break
                except ValueError:
                    pass

        # 3. Detect Quantity (e.g. '2x', '5kg', '3 packets', or leading number)
        qty_match = re.search(r'^\s*(\d+(?:\.\d+)?)\s*(?:x|kg|gm|ltr|pcs|nos|packets|units)?\b', working_line, re.IGNORECASE)
        if qty_match:
            try:
                matched_qty = float(qty_match.group(1))
                if matched_qty != price:
                    qty = matched_qty
                    working_line = working_line[qty_match.end():].strip()
            except ValueError:
                pass

        if not price_found:
            trailing = re.search(r'(\d+(?:\.\d+)?)\s*$', working_line)
            if trailing:
                try:
                    price = float(trailing.group(1))
                    working_line = working_line[:trailing.start()].strip()
                except ValueError:
                    pass

        # 4. Clean up product name
        name = re.sub(r'\s+', ' ', working_line).strip(' ,;:-@')
        name = re.sub(r'\b(at|for|with|each|gst|rs|price|cost|qty)\b', '', name, flags=re.IGNORECASE).strip(' ,;:-@')
        if not name:
            name = f"Product {len(parsed_items) + 1}"
        if price <= 0:
            price = 50.0

        parsed_items.append(Item(name=name.title(), quantity=qty, price=price, gst_rate=gst_rate))

    return parsed_items


