# 4. BILL CALCULATION ENGINE
# =============================================================================
class BillCalculator:
    """Core mathematical engine for GST calculations and invoice synthesis."""

    @staticmethod
    def generate_upi_link(vpa: str, payee_name: str, amount: float, invoice_no: str) -> str:
        """Generates standard NPCI UPI payment deep link string."""
        pa = quote(vpa.strip())
        pn = quote(payee_name.strip())
        tn = quote(f"Bill {invoice_no}")
        return f"upi://pay?pa={pa}&pn={pn}&am={amount:.2f}&cu=INR&tn={tn}"

    @classmethod
    def calculate(
        cls,
        items: List[Item],
        discount_type: str = "percentage",  # 'percentage' or 'flat'
        discount_value: float = 0.0,
        tax_type: str = "intra",            # 'intra' (CGST+SGST) or 'inter' (IGST)
        apply_round_off: bool = True,
        vpa: str = "merchant@upi",
        payee_name: str = "Store Billing",
        invoice_no: str = "INV-001"
    ) -> BillSummary:
        """
        Calculates subtotal, discounts, CGST/SGST or IGST tax splits,
        nearest Rupee round-off, amount in words, and payment deep-links.
        """
        subtotal = sum(it.taxable_amount for it in items)
        gross_tax = sum(it.gst_amount for it in items)

        # 1. Discount deduction
        disc_val = max(0.0, float(discount_value))
        if discount_type == "percentage":
            discount_amount = round((subtotal * disc_val) / 100.0, 2)
        else:
            discount_amount = round(min(disc_val, subtotal), 2)

        net_taxable = round(max(0.0, subtotal - discount_amount), 2)

        # 2. Prorated tax if discount is applied across bill
        if subtotal > 0 and discount_amount > 0:
            tax_ratio = net_taxable / subtotal
            total_tax = round(gross_tax * tax_ratio, 2)
        else:
            total_tax = round(gross_tax, 2)

        # 3. Tax Split: CGST/SGST (Intra-state) vs IGST (Inter-state)
        cgst_amount = 0.0
        sgst_amount = 0.0
        igst_amount = 0.0

        if tax_type == "intra":
            cgst_amount = round(total_tax / 2.0, 2)
            sgst_amount = round(total_tax - cgst_amount, 2)  # Avoid decimal drift
        else:
            igst_amount = total_tax

        # 4. Total calculation and Round-Off
        unrounded_total = net_taxable + total_tax
        if apply_round_off:
            rounded_total = float(round(unrounded_total))
            round_off = round(rounded_total - unrounded_total, 2)
            grand_total = rounded_total
        else:
            round_off = 0.0
            grand_total = round(unrounded_total, 2)

        # 5. Tax slabs summary
        slab_dict: Dict[float, Dict[str, float]] = {}
        for it in items:
            rate = it.gst_rate
            if rate not in slab_dict:
                slab_dict[rate] = {"taxable": 0.0, "tax": 0.0}
            slab_dict[rate]["taxable"] += it.taxable_amount
            slab_dict[rate]["tax"] += it.gst_amount

        tax_slabs = [
            {"rate": r, "taxable": round(data["taxable"], 2), "tax": round(data["tax"], 2)}
            for r, data in sorted(slab_dict.items())
        ]

        # 6. Currency words and UPI payment string
        words = amount_to_indian_words(grand_total)
        upi = cls.generate_upi_link(vpa, payee_name, grand_total, invoice_no)

        return BillSummary(
            items=items,
            subtotal=round(subtotal, 2),
            discount_type=discount_type,
            discount_value=disc_val,
            discount_amount=discount_amount,
            net_taxable=net_taxable,
            tax_type=tax_type,
            cgst_amount=cgst_amount,
            sgst_amount=sgst_amount,
            igst_amount=igst_amount,
            total_tax=total_tax,
            round_off=round_off,
            grand_total=grand_total,
            amount_in_words=words,
            tax_slabs=tax_slabs,
            upi_link=upi
        )


