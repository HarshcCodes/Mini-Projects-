@dataclass
class Item:
    """Represents an individual purchased product or service."""
    name: str
    quantity: float
    price: float
    gst_rate: float = 18.0  # GST slabs: 0%, 5%, 12%, 18%, 28%
    hsn: str = ""

    @property
    def taxable_amount(self) -> float:
        """Gross line amount before GST: (Quantity x Unit Price)."""
        return round(self.quantity * self.price, 2)

    @property
    def gst_amount(self) -> float:
        """Tax amount calculated for this item."""
        return round((self.taxable_amount * self.gst_rate) / 100.0, 2)

    @property
    def line_total(self) -> float:
        """Total line amount including GST."""
        return round(self.taxable_amount + self.gst_amount, 2)


@dataclass
class BillSummary:
    """Represents the complete computed billing output."""
    items: List[Item]
    subtotal: float
    discount_type: str
    discount_value: float
    discount_amount: float
    net_taxable: float
    tax_type: str  # 'intra' (CGST+SGST) or 'inter' (IGST)
    cgst_amount: float
    sgst_amount: float
    igst_amount: float
    total_tax: float
    round_off: float
    grand_total: float
    amount_in_words: str
    tax_slabs: List[Dict[str, float]]
    upi_link: str


