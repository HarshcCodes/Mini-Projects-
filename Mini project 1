# 5. FORMATTED BILL RENDERERS
# =============================================================================
class BillFormatter:
    """Renders formatted bills in Executive A4 table format and POS Thermal Slip."""

    @staticmethod
    def render_a4(company: dict, customer: dict, b: BillSummary, inv_no: str, date_str: str) -> str:
        w = 68
        border = "=" * w
        dash = "-" * w
        lines = [
            border,
            f"{'TAX INVOICE':^{w}}",
            f"{company.get('name', 'Apex Retail Store'):^{w}}",
            f"{company.get('address', 'Mumbai, India'):^{w}}",
            f"GSTIN: {company.get('gstin', '27AAPFU0939F1ZV'):^{w}}",
            border,
            f" Invoice No : {inv_no:<24} Date: {date_str:>23}",
            f" Customer   : {customer.get('name', 'Walk-in'):<24} Phone: {customer.get('phone', 'N/A'):>22}",
            dash,
            f" {'#':<2} {'Item Description':<26} {'Qty':>5} {'Rate':>9} {'GST%':>5} {'Total (Rs)':>12}",
            dash
        ]

        for idx, it in enumerate(b.items, 1):
            name = it.name[:26]
            lines.append(f" {idx:<2} {name:<26} {it.quantity:>5.1f} {it.price:>9.2f} {it.gst_rate:>4.0f}% {it.line_total:>12.2f}")

        lines.extend([
            dash,
            f" {'Gross Subtotal:':<50} Rs. {b.subtotal:>12.2f}",
        ])

        if b.discount_amount > 0:
            lines.append(f" {'Discount Applied:':<50} -Rs. {b.discount_amount:>11.2f}")
            lines.append(f" {'Net Taxable Base:':<50} Rs. {b.net_taxable:>12.2f}")

        if b.tax_type == "intra":
            lines.append(f" {'CGST (Central Tax 50%):':<50} Rs. {b.cgst_amount:>12.2f}")
            lines.append(f" {'SGST (State Tax 50%):':<50} Rs. {b.sgst_amount:>12.2f}")
        else:
            lines.append(f" {'IGST (Integrated Tax 100%):':<50} Rs. {b.igst_amount:>12.2f}")

        if b.round_off != 0.0:
            lines.append(f" {'Round Off Adjustment:':<50} Rs. {b.round_off:>12.2f}")

        lines.extend([
            border,
            f" {'GRAND TOTAL PAYABLE:':<50} Rs. {b.grand_total:>12.2f}",
            border,
            " Amount in Words:",
            f" >> {b.amount_in_words}",
            dash,
            f" Instant UPI Payment Link (Scan & Pay):",
            f" >> {b.upi_link}",
            border,
            f"{'Thank you for your business! Please visit again.':^{w}}",
            border
        ])
        return "\n".join(lines)

    @staticmethod
    def render_thermal(company: dict, customer: dict, b: BillSummary, inv_no: str, date_str: str) -> str:
        w = 40
        dash = "-" * w
        dots = "." * w
        lines = [
            dots,
            f"{company.get('name', 'Apex Retail')[:w]:^{w}}",
            f"GSTIN: {company.get('gstin', '27AAPFU0939F1ZV'):^{w}}",
            dots,
            f"RCPT: {inv_no:<14} {date_str:>16}",
            f"CUST: {customer.get('name', 'Walk-in')[:20]}",
            dash,
            f"ITEM                 QTYxPRICE     TOTAL",
            dash
        ]

        for it in b.items:
            lines.append(f"{it.name[:18]:<18} {it.quantity:.0f}x{it.price:<7.1f} {it.line_total:>9.2f}")

        lines.extend([
            dash,
            f"SUBTOTAL:                    Rs. {b.subtotal:>8.2f}",
        ])
        if b.discount_amount > 0:
            lines.append(f"DISCOUNT:                   -Rs. {b.discount_amount:>8.2f}")

        lines.append(f"TOTAL GST:                   Rs. {b.total_tax:>8.2f}")
        if b.round_off != 0.0:
            lines.append(f"ROUND OFF:                   Rs. {b.round_off:>8.2f}")

        lines.extend([
            dash,
            f"TOTAL PAYABLE:               Rs. {b.grand_total:>8.2f}",
            dash,
            f"UPI VPA: {company.get('upi_id', 'store@upi')}",
            f"{'*** THANK YOU! ***':^{w}}",
            dots
        ])
        return "\n".join(lines)


