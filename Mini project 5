# 7. FEATURE D: "ANOMALY RADAR" (Z-SCORE ENGINE)
# ==============================================================================

def detect_sales_anomalies(df: pd.DataFrame, threshold_z: float = 2.2) -> list:
    """
    Feature D: Flags unusual sales days using statistical Z-Score on daily revenue.
    Infers rule-based diagnostic causes (Black Friday surges, storms, clearance days).
    """
    if df.empty:
        return []

    daily = df.groupby(df["Date"].dt.date).agg(
        Sales=("Sales", "sum"),
        Orders=("Order_ID", "nunique"),
        Avg_Discount=("Discount", "mean"),
        Top_Category=("Category", lambda x: x.mode()[0] if not x.empty else "N/A"),
    ).reset_index()

    daily["Date"] = pd.to_datetime(daily["Date"])
    mean_s = daily["Sales"].mean()
    std_s = daily["Sales"].std()

    if std_s == 0 or np.isnan(std_s):
        return []

    daily["Z"] = (daily["Sales"] - mean_s) / std_s
    daily["Dev"] = ((daily["Sales"] - mean_s) / max(mean_s, 1)) * 100.0

    outliers = daily[daily["Z"].abs() >= threshold_z].copy()
    results = []

    for _, r in outliers.iterrows():
        z_val = float(r["Z"])
        dev_val = float(r["Dev"])
        sales_val = float(r["Sales"])
        disc = float(r["Avg_Discount"])
        day_name = r["Date"].strftime("%A")

        if z_val > 0:
            a_type = "spike"
            if disc >= 0.22:
                reason = f"Promotional Clearance Surge (Avg Disc: {disc*100:.0f}%, {int(r['Orders'])} orders)"
            elif r["Date"].month in [11, 12]:
                reason = f"Holiday / Cyber Season Demand Peak ({r['Top_Category']}, {int(r['Orders'])} orders)"
            elif day_name in ["Saturday", "Sunday"]:
                reason = f"Weekend Customer Traffic Spike (+{dev_val:.0f}% vs mean)"
            else:
                reason = f"Flash Volume Surge in {r['Top_Category']} ({int(r['Orders'])} orders)"
        else:
            a_type = "drop"
            if sales_val <= 0.15 * mean_s:
                reason = f"Severe Outage / Extreme Weather Closure (Sales down {abs(dev_val):.0f}%)"
            else:
                reason = f"Midweek Purchasing Lull ({int(r['Orders'])} transactions)"

        results.append({
            "date": r["Date"].strftime("%Y-%m-%d"),
            "day": day_name,
            "sales": round(sales_val, 2),
            "orders": int(r["Orders"]),
            "z_score": round(z_val, 2),
            "deviation_pct": f"{'+' if dev_val > 0 else ''}{dev_val:.1f}%",
            "type": a_type,
            "reason": reason,
        })

    return sorted(results, key=lambda x: abs(x["z_score"]), reverse=True)


