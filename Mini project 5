# 6. FEATURE C: "BUSINESS HEALTH SCORE" (0-100 GAUGE & PILLARS)
# ==============================================================================

def calculate_business_health_score(df: pd.DataFrame, theme: str = "light") -> dict:
    """
    Feature C: Evaluates 4 operational pillars (Growth, Margin, Discount Discipline, Stability)
    out of 25 points each, returning a 0-100 score, factor breakdown, and a Matplotlib gauge chart.
    """
    if df.empty or len(df) < 5:
        return {"total_score": 50, "rating": "Average"}

    # Pillar 1: Growth Rate (0 - 25 pts)
    df_s = df.sort_values("Date").reset_index(drop=True)
    mid = len(df_s) // 2
    f_sales = df_s.iloc[:mid]["Sales"].sum()
    s_sales = df_s.iloc[mid:]["Sales"].sum()
    growth_pct = ((s_sales - f_sales) / max(f_sales, 1)) * 100.0

    if growth_pct >= 20.0: p1 = 25.0
    elif growth_pct >= 10.0: p1 = 20.0 + (growth_pct - 10.0) * 0.5
    elif growth_pct >= 0.0: p1 = 14.0 + (growth_pct) * 0.6
    else: p1 = max(0.0, 14.0 + (growth_pct) * 0.6)

    # Pillar 2: Profit Margin Health (0 - 25 pts)
    total_sales = df["Sales"].sum()
    total_profit = df["Profit"].sum()
    margin = (total_profit / total_sales * 100.0) if total_sales > 0 else 0.0

    if margin >= 42.0: p2 = 25.0
    elif margin >= 30.0: p2 = 18.0 + (margin - 30.0) * (7.0 / 12.0)
    elif margin >= 18.0: p2 = 10.0 + (margin - 18.0) * (8.0 / 12.0)
    else: p2 = max(0.0, margin * 0.55)

    # Pillar 3: Discount Discipline (0 - 25 pts)
    avg_d = df["Discount"].mean() * 100.0
    heavy_d = (df["Discount"] > 0.20).mean() * 100.0
    penalty = (avg_d * 0.7) + (heavy_d * 0.5)
    p3 = max(0.0, min(25.0, 25.0 - (penalty * 0.75)))

    # Pillar 4: Sales Consistency / Stability (0 - 25 pts)
    daily = df.groupby(df["Date"].dt.date)["Sales"].sum()
    cv = (daily.std() / daily.mean()) if daily.mean() > 0 else 1.0  # Coefficient of Variation

    if cv <= 0.40: p4 = 25.0
    elif cv <= 0.65: p4 = 18.0 + (0.65 - cv) * (7.0 / 0.25)
    elif cv <= 0.95: p4 = 10.0 + (0.95 - cv) * (8.0 / 0.30)
    else: p4 = max(2.0, 10.0 - (cv - 0.95) * 12.0)

    total_score = round(p1 + p2 + p3 + p4)
    total_score = max(0, min(100, total_score))

    if total_score >= 80: rating, r_color = "Excellent", "#10b981"
    elif total_score >= 65: rating, r_color = "Healthy", "#3b82f6"
    elif total_score >= 40: rating, r_color = "Average", "#f59e0b"
    else: rating, r_color = "Critical", "#ef4444"

    pillars = [
        {"name": "Sales Growth", "score": round(p1, 1), "metric": f"{growth_pct:+.1f}% half-over-half"},
        {"name": "Profit Margin", "score": round(p2, 1), "metric": f"{margin:.1f}% margin"},
        {"name": "Discount Discipline", "score": round(p3, 1), "metric": f"{avg_d:.1f}% avg discount"},
        {"name": "Revenue Stability", "score": round(p4, 1), "metric": f"{cv:.2f} volatility ratio"},
    ]
    sorted_p = sorted(pillars, key=lambda x: x["score"])

    # Render Gauge Chart in Matplotlib
    bg_color = "#161b22" if theme == "dark" else "#ffffff"
    text_color = "#e6edf3" if theme == "dark" else "#1f2937"

    fig, ax = plt.subplots(figsize=(5.5, 3.2), dpi=100)
    fig.patch.set_facecolor(bg_color)
    ax.set_facecolor(bg_color)

    wedges = [(108, 180, "#ef4444"), (63, 108, "#f59e0b"), (36, 63, "#3b82f6"), (0, 36, "#10b981")]
    for t1, t2, col in wedges:
        ax.add_patch(Wedge((0, 0), 1.0, t1, t2, width=0.32, facecolor=col, edgecolor=bg_color, lw=2))

    needle_angle = 180.0 - (total_score * 1.8)
    rad = np.radians(needle_angle)
    ax.plot([0, 0.78 * np.cos(rad)], [0, 0.78 * np.sin(rad)], color=text_color, lw=3.5, solid_capstyle="round")
    ax.add_patch(Circle((0, 0), 0.12, facecolor=text_color, edgecolor=bg_color, lw=2))

    ax.text(0, -0.22, f"{total_score}", ha="center", va="center", fontsize=26, fontweight="bold", color=r_color)
    ax.text(0, -0.42, f"/ 100 • {rating}", ha="center", va="center", fontsize=11, fontweight="bold", color=text_color)
    ax.set_xlim(-1.25, 1.25)
    ax.set_ylim(-0.55, 1.15)
    ax.set_aspect("equal")
    ax.axis("off")
    plt.tight_layout()

    buf = io.BytesIO()
    plt.savefig(buf, format="png", dpi=100, bbox_inches="tight", facecolor=bg_color)
    plt.close(fig)
    buf.seek(0)
    gauge_b64 = f"data:image/png;base64,{base64.b64encode(buf.read()).decode('utf-8')}"

    return {
        "total_score": total_score,
        "rating": rating,
        "color": r_color,
        "pillars": pillars,
        "constraining_factor": f"{sorted_p[0]['name']} is dragging the score ({sorted_p[0]['score']:.1f}/25)",
        "primary_catalyst": f"{sorted_p[-1]['name']} is propelling performance ({sorted_p[-1]['score']:.1f}/25)",
        "gauge_chart_base64": gauge_b64,
    }


